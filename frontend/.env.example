# Red: 11155111 (Sepolia) o 31337 (anvil local)
NEXT_PUBLIC_CHAIN_ID=11155111
# RPC para lecturas (opcional; si se omite usa el RPC público de la red).
# Para Sepolia conviene uno que acepte rangos amplios en eth_getLogs (ej. Infura o publicnode).
NEXT_PUBLIC_RPC_URL=
# Direcciones desplegadas: `npm run sync` las copia de ../deployments/<chainId>.json
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_TOKENIZER_ADDRESS=
# Bloque del deploy: desde acá se leen los eventos (propuestas y actividad)
NEXT_PUBLIC_START_BLOCK=0
