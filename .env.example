# RPC de Sepolia (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=
# API key de Etherscan para verificar contratos
ETHERSCAN_API_KEY=

# Direcciones de las billeteras de la demo (NO private keys: usar `cast wallet import`)
CREATOR_ADDRESS=
INVESTOR_A_ADDRESS=
INVESTOR_B_ADDRESS=

# Metadata ERC-1155 (IPFS); {id} lo reemplaza el cliente
TOKEN_URI=ipfs://REPLACE_ME/{id}.json
